# F.R.I.D.A.Y. settings. Copy to .env (chmod 600) and uncomment what you change.
# Every entry point reads it: the service, `bin/friday enroll` and `bin/friday voice`.
# A variable set in the real environment wins over this file.
# After editing: systemctl --user restart friday
# Give paths absolute: ~ and relative paths are not expanded.

# --- Wake word (listener/wake.py) ---
# PipeWire source for pw-record --target; default: the default source, or the best non-Bluetooth mic
# FRIDAY_MIC=
# Minimum Vosk word confidence for "Friday"
# FRIDAY_MIN_CONF=0.6
# Vosk model directory
# default: <repo>/models/vosk-model-small-en-us-0.15
# FRIDAY_MODEL=/absolute/path

# --- Voice commands: speech to text (listener/command.py) ---
# Without it the HUD reports that commands cannot be transcribed
# OPENAI_API_KEY=
# OpenAI transcription model
# FRIDAY_STT_MODEL=gpt-transcribe
# Language hint (ISO 639-1), or auto; English commands still transcribe correctly with vi
# FRIDAY_STT_LANGUAGE=vi
# Silero VAD ONNX model that decides when a command starts and ends
# default: <repo>/models/silero_vad.onnx
# FRIDAY_VAD_MODEL=/absolute/path

# --- Speaker verification (listener/speaker.py) ---
# Enrolled voiceprint; without the file any voice may command
# default: $XDG_DATA_HOME/friday/voiceprint.json (~/.local/share/...)
# FRIDAY_VOICEPRINT=/absolute/path
# Minimum voice match (cosine similarity, 0..1)
# FRIDAY_SPEAKER_THRESHOLD=0.45
# WeSpeaker ONNX speaker model
# default: <repo>/models/wespeaker_en_voxceleb_resnet34_LM.onnx
# FRIDAY_SPEAKER_MODEL=/absolute/path
# Folder to keep every scored voice sample in (private WAVs), for tuning the threshold; delete it afterwards
# FRIDAY_VOICE_LOG=

# --- Hermes agent (app/src/agent.js); unset URL or key disables the bridge ---
# FRIDAY_AGENT_URL=https://hermes.example.com
# The server's API_SERVER_KEY; as powerful as the agent itself, keep this file 0600
# FRIDAY_AGENT_KEY=
# FRIDAY_AGENT_MODEL=hermes-agent
# Session id prefix; empty makes every command stateless
# FRIDAY_AGENT_SESSION=friday
# A pause longer than this (seconds) after the last reply starts a new conversation
# FRIDAY_AGENT_SESSION_IDLE_S=600
# Abandon a run after this many seconds
# FRIDAY_AGENT_TIMEOUT_S=120

# --- Jev intent router (app/src/router.js); unset key sends every command to the agent ---
# JevStation key (sk_...), or a TypeSafe key together with FRIDAY_JEV_URL below
# JEV_API_KEY=
# FRIDAY_JEV_URL=https://jevstation.com/api/v1/systemone
# TypeSafe direct: FRIDAY_JEV_URL=https://api.typesafe.ai/v1/systemone
# Pinned, so the confidence threshold does not drift when an alias moves
# FRIDAY_JEV_MODEL=jev-1.13.0
# Below this confidence (0..1) the command goes to the agent instead
# FRIDAY_JEV_MIN_CONFIDENCE=0.5
# Give up on Jev after this many seconds and send the command to the agent
# FRIDAY_JEV_TIMEOUT_S=8

# --- Browser agent (app/src/browse/); a browse command needs the Jev key above ---
# off disables it; a browse command then goes to the agent
# FRIDAY_BROWSE=on
# Where a browse run opens; must be https
# FRIDAY_BROWSE_START_URL=https://www.google.com/
# Stop a run after this many seconds
# FRIDAY_BROWSE_TIMEOUT_S=120
# Chrome profile whose DevToolsActivePort is read
# default: ~/.config/google-chrome
# FRIDAY_BROWSE_CHROME_DIR=/absolute/path
# Loopback ws:// CDP URL, when Chrome is reached another way; never a remote host
# FRIDAY_BROWSE_CDP_URL=ws://127.0.0.1:9222/devtools/browser/<uuid>
# Text model for TYPE_TEXT only: any OpenAI-compatible /chat/completions endpoint
# FRIDAY_BROWSE_TEXT_URL=https://api.openai.com/v1
# FRIDAY_BROWSE_TEXT_KEY=
# FRIDAY_BROWSE_TEXT_MODEL=gpt-4o-mini
# Or a model on this machine (plain http is allowed only for loopback, no key needed):
# FRIDAY_BROWSE_TEXT_URL=http://127.0.0.1:8080/v1
# FRIDAY_BROWSE_TEXT_MODEL=qwen3.5-4b
# FRIDAY_BROWSE_TEXT_EXTRA={"chat_template_kwargs":{"enable_thinking":false}}
# Optional JSON object merged into the text request (never model/messages/response_format)
# FRIDAY_BROWSE_TEXT_EXTRA={"reasoning_effort":"low"}

# --- Spoken replies (listener/tts.py) ---
# off keeps replies silent and frees the voice model's memory
# FRIDAY_TTS=on
# Voice exported by `bin/friday voice`; without the file replies are silent
# default: <repo>/models/tts-voice.safetensors
# FRIDAY_TTS_VOICE=/absolute/path

# --- Gesture control (listener/hands.py, app/src/gestures.js) ---
# Camera that watches the hands while gesture control is on; a /dev/v4l/by-id/ path survives replugging
# FRIDAY_CAMERA=/dev/video0
# MediaPipe hand landmarker model
# default: <repo>/models/hand_landmarker.task
# FRIDAY_HAND_MODEL=/absolute/path
# Gesture control turns itself off (and the camera with it) after this many seconds without a hand in view
# FRIDAY_GESTURE_IDLE_S=20
# How long a finger count is held before it fires, a fist before it grabs the
# focused window, and how long a grab waits for the count to carry it to (ms)
# FRIDAY_GESTURE_HOLD_MS=500
# FRIDAY_GESTURE_GRAB_MS=300
# FRIDAY_GESTURE_CARRY_MS=3000
# 1 shows a debug window with the camera picture and what gesture control sees
# FRIDAY_GESTURE_DEBUG=1

# --- Diagram Studio (diagram/); see diagram/README.md ---
# claude-code (local Claude Code CLI), hermes (Hermes API server) or fake (no AI, for tests)
# DIAGRAM_AGENT=claude-code
# DIAGRAM_HOST=127.0.0.1
# DIAGRAM_PORT=8790
# Access token; required when DIAGRAM_HOST is not a loopback address
# DIAGRAM_TOKEN=
# Public address behind an HTTPS reverse proxy, exactly as the browser shows it
# DIAGRAM_PUBLIC_ORIGIN=https://diagrams.example.com
# Projects folder, relative to the repository root
# DIAGRAM_DATA_DIR=diagram/data
# Abandon an agent call after this many seconds
# DIAGRAM_AGENT_TIMEOUT_S=180
# Passed to claude as --model
# DIAGRAM_CLAUDE_MODEL=
# Hermes API server; default: the FRIDAY_AGENT_* values above
# DIAGRAM_HERMES_URL=https://hermes.example.com
# DIAGRAM_HERMES_KEY=
# DIAGRAM_HERMES_MODEL=hermes-agent
# Abuse limits
# DIAGRAM_MAX_PROJECTS=500
# DIAGRAM_AUTH_ATTEMPTS_PER_MINUTE=10
# DIAGRAM_AGENT_CALLS_PER_MINUTE=20

# --- Development ---
# 1 logs steady-state fps after each wake
# FRIDAY_DEBUG=
# Python that runs the listener helpers
# default: <repo>/.venv/bin/python
# FRIDAY_PYTHON=/absolute/path
